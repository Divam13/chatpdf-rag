# ============================================================
# Root .gitignore — ChatPDF RAG
# ============================================================

# --- Secrets (never commit .env files, except examples) ---
**/.env
**/.env.*
!**/.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Node / Next.js ---
node_modules/
.next/
out/
build/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Legacy on-disk indexes (superseded by pgvector) ---
faiss_db/
user_indexes/
routes/user_indexes/

# --- Local sample data / scratch ---
*.pdf
*.tmp
tmp/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Vercel ---
.vercel

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Coverage ---
coverage/
