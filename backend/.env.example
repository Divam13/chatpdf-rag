# ============================================================
# ChatPDF Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.

# MongoDB connection string (MongoDB Atlas M0 or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority

# Supabase configuration (for Storage and pgvector)
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=pdfs

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides (defaults are shown)
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
