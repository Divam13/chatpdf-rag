# ============================================================
# ChatPDF Frontend — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the correct URL.
# NEVER commit the .env.local file itself.

# URL of the FastAPI backend.
# For local development this is http://localhost:8000.
# In production, set this to your deployed backend URL (e.g. https://chatpdf-backend.onrender.com).
NEXT_PUBLIC_API_URL=http://localhost:8000
